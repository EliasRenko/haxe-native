# Copy resources (using --macro to ensure execution)
--macro Sys.command("cmd", ["/c", ".\\bat\\copy-files.bat", ".\\include", ".\\bin\\native.debug\\include"])
--macro Sys.command("cmd", ["/c", ".\\bat\\copy-files.bat", ".\\lib", ".\\bin\\native.debug\\lib"])
--macro Sys.command("cmd", ["/c", ".\\bat\\copy-files.bat", ".\\res", ".\\bin\\native.debug\\res"])
--macro Sys.command("cmd", ["/c", "if not exist bin\\native.debug\\src mkdir bin\\native.debug\\src"])
--macro Sys.command("cmd", ["/c", "copy src\\glad.c bin\\native.debug\\src\\glad.c"])
--macro Sys.command("cmd", ["/c", "copy lib\\SDL3.dll bin\\native.debug\\SDL3.dll"])

-cp src 
-cp test
-main Main
-cpp bin/native.debug

-D HXCPP_native.DEBUGGER
-D HXCPP_M64
-D HXCPP_CPP11
-D HXCPP_NO_PCH
-D HXCPP_NO_PRECOMPILED_HEADERS
-D no-deprecation-warnings

-lib hxcpp-debug-server

-debug 
-dce std
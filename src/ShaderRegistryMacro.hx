
#if macro
import haxe.macro.Context;
import haxe.macro.Expr;
import haxe.macro.Type;
import haxe.io.Path;
import sys.FileSystem;

typedef UniformData = {
    var name:String;
    var index:Int;
}

typedef ShaderData = {
    var id:Int;
    var name:String;
    var path:Array<String>;
    var vertexSource:String;
    var fragmentSource:String;
    var uniforms:Array<UniformData>;
}

class ShaderRegistryMacro {

    public static function build(packageName:String):Array<Field> {
        var fields = Context.getBuildFields();
        var pos = Context.currentPos();

        var packagePath = StringTools.replace(packageName, ".", "/");
        var modules:Array<String> = [];

        // 1. Scan every Haxe classpath.
        for (classPath in Context.getClassPath()) {
            var directory = Path.join([classPath, packagePath]);

            if (!FileSystem.exists(directory)
                || !FileSystem.isDirectory(directory)) {
                continue;
            }

            for (file in FileSystem.readDirectory(directory)) {
                if (Path.extension(file) != "hx") {
                    continue;
                }

                var moduleName = Path.withoutExtension(file);

                if (StringTools.startsWith(moduleName, "_")) {
                    continue;
                }

                modules.push(packageName + "." + moduleName);
            }
        }

        // 2. Deduplicate module paths and sort them.
        var uniqueModules:Array<String> = [];

        for (moduleName in modules) {
            if (uniqueModules.indexOf(moduleName) == -1) {
                uniqueModules.push(moduleName);
            }
        }

        uniqueModules.sort(Reflect.compare);

        if (uniqueModules.length == 0) {
            Context.error(
                'No Haxe modules found for package "$packageName".',
                pos
            );
        }

        // 3. Discover and validate shader classes.
        var shaders:Array<ShaderData> = [];
        var seen = new Map<String, Bool>();

        for (moduleName in uniqueModules) {
            var types:Array<Type>;

            try {
                types = Context.getModule(moduleName);
            } catch (e:Dynamic) {
                Context.error(
                    'Could not load shader module "$moduleName": $e',
                    pos
                );
                continue;
            }

            for (type in types) {
                switch (type) {
                    case TInst(classRef, _):
                        var cls = classRef.get();
                        var expectedName =
                            moduleName.split(".").pop();

                        // Only inspect the class matching the filename.
                        if (cls.name != expectedName) {
                            continue;
                        }

                        if (!extendsShader(cls)) {
                            continue;
                        }

                        var className =
                            cls.pack.concat([cls.name]).join(".");

                        if (seen.exists(className)) {
                            Context.error(
                                'Duplicate shader registration: $className',
                                cls.pos
                            );
                            continue;
                        }

                        seen.set(className, true);

                        validateShader(cls);

                        shaders.push({
                            id: getShaderId(cls),
                            name: className,
                            path: cls.pack.concat([cls.name]),
                            vertexSource: getMetadataString(
                                cls,
                                ":shaderSourceVert"
                            ),
                            fragmentSource: getMetadataString(
                                cls,
                                ":shaderSourceFrag"
                            ),
                            uniforms: getUniformDefinitions(cls)
                        });

                    default:
                }
            }
        }

        // 4. Sort using the IDs generated by ShaderGenMacro.
        shaders.sort(function(a, b) {
            return a.id - b.id;
        });

        // 5. IDs used as array indices must be unique and contiguous.
        for (i in 0...shaders.length) {
            if (shaders[i].id != i) {
                Context.error(
                    'Shader IDs must be contiguous from 0. Expected $i, '
                    + 'got ${shaders[i].id} for ${shaders[i].name}.',
                    pos
                );
            }
        }

        // 6. Generate the shader class array.
        var classExpressions:Array<Expr> = [];

        for (shader in shaders) {
            var path = shader.path;
            classExpressions.push(macro $p{path});
        }

        fields.push({
            name: "shaderClasses",
            access: [APublic, AStatic, AFinal],
            kind: FVar(
                macro:Array<Class<data.Shader>>,
                macro $a{classExpressions}
            ),
            pos: pos
        });

        // 7. Generate ShaderDefinition objects, including uniform definitions.
        var definitionExpressions:Array<Expr> = [];

        for (shader in shaders) {
            var name = shader.name;
            var id = shader.id;
            var vertexSource = shader.vertexSource;
            var fragmentSource = shader.fragmentSource;

            var uniformExpressions:Array<Expr> = [];

            for (uniform in shader.uniforms) {
                var uniformName = uniform.name;
                var uniformIndex = uniform.index;

                uniformExpressions.push(
                    macro {
                        name: $v{uniformName},
                        index: $v{uniformIndex}
                    }
                );
            }

            definitionExpressions.push(
                macro new ShaderDefinition(
                    $v{name},
                    $v{id},
                    $v{vertexSource},
                    $v{fragmentSource},
                    $a{uniformExpressions}
                )
            );
        }

        fields.push({
            name: "definitions",
            access: [APublic, AStatic, AFinal],
            kind: FVar(
                macro:Array<ShaderDefinition>,
                macro $a{definitionExpressions}
            ),
            pos: pos
        });

        Context.info(
            'Discovered ${shaders.length} shaders in "$packageName".',
            pos
        );

        return fields;
    }

    static function extendsShader(
        cls:haxe.macro.Type.ClassType
    ):Bool {
        var parent = cls.superClass;

        while (parent != null) {
            var parentClass = parent.t.get();

            if (parentClass.name == "Shader"
                && parentClass.pack.length == 1
                && parentClass.pack[0] == "data") {
                return true;
            }

            parent = parentClass.superClass;
        }

        return false;
    }

    static function validateShader(
        cls:haxe.macro.Type.ClassType
    ):Void {
        var hasVertex = false;
        var hasFragment = false;

        for (meta in cls.meta.get()) {
            switch (meta.name) {
                case ":shaderSourceVert":
                    hasVertex = true;

                case ":shaderSourceFrag":
                    hasFragment = true;

                default:
            }
        }

        if (!hasVertex) {
            Context.error(
                '${cls.name} is missing @:shaderSourceVert metadata.',
                cls.pos
            );
        }

        if (!hasFragment) {
            Context.error(
                '${cls.name} is missing @:shaderSourceFrag metadata.',
                cls.pos
            );
        }
    }

    static function getMetadataString(
        cls:haxe.macro.Type.ClassType,
        metadataName:String
    ):String {
        for (meta in cls.meta.get()) {
            if (meta.name != metadataName) {
                continue;
            }

            if (meta.params == null || meta.params.length != 1) {
                Context.error(
                    '$metadataName on ${cls.name} must have one argument.',
                    cls.pos
                );
                return "";
            }

            switch (meta.params[0].expr) {
                case EConst(CString(value, _)):
                    return value;

                default:
                    Context.error(
                        '$metadataName on ${cls.name} must contain a string literal.',
                        meta.params[0].pos
                    );
                    return "";
            }
        }

        Context.error(
            '${cls.name} is missing $metadataName metadata.',
            cls.pos
        );

        return "";
    }

    static function getShaderId(
        cls:haxe.macro.Type.ClassType
    ):Int {
        for (meta in cls.meta.get()) {
            if (meta.name != ":shaderId") {
                continue;
            }

            if (meta.params == null || meta.params.length != 1) {
                Context.error(
                    'Invalid shaderId metadata on ${cls.name}.',
                    cls.pos
                );
                return -1;
            }

            switch (meta.params[0].expr) {
                case EConst(CInt(value)):
                    return Std.parseInt(value);

                default:
                    Context.error(
                        'shaderId on ${cls.name} must be an integer.',
                        meta.params[0].pos
                    );
                    return -1;
            }
        }

        Context.error(
            'No generated :shaderId metadata found for ${cls.name}. '
            + 'Check that ShaderGenMacro adds the metadata.',
            cls.pos
        );

        return -1;
    }

    static function getUniformDefinitions(
        cls:haxe.macro.Type.ClassType
    ):Array<UniformData> {
        var uniforms:Array<UniformData> = [];
        var seenNames = new Map<String, Bool>();
        var seenIndices = new Map<Int, Bool>();

        // Inspect fields declared on this shader class.
        for (field in cls.fields.get()) {
            var uniformMeta:Null<MetadataEntry> = null;

            for (meta in field.meta.get()) {
                if (meta.name == ":uniform") {
                    uniformMeta = meta;
                    break;
                }
            }

            if (uniformMeta == null) {
                continue;
            }

            var params = uniformMeta.params;

            if (params == null || params.length != 2) {
                Context.error(
                    '@:uniform on ${cls.name}.${field.name} must have '
                    + 'exactly two arguments: ("name", index).',
                    field.pos
                );
                continue;
            }

            var uniformName:String;

            switch (params[0].expr) {
                case EConst(CString(value, _)):
                    uniformName = value;

                default:
                    Context.error(
                        'The first @:uniform argument on '
                        + '${cls.name}.${field.name} must be a string.',
                        params[0].pos
                    );
                    continue;
            }

            var uniformIndex:Int;

            switch (params[1].expr) {
                case EConst(CInt(value)):
                    uniformIndex = Std.parseInt(value);

                default:
                    Context.error(
                        'The second @:uniform argument on '
                        + '${cls.name}.${field.name} must be an integer.',
                        params[1].pos
                    );
                    continue;
            }

            if (uniformName.length == 0) {
                Context.error(
                    'Uniform names cannot be empty in ${cls.name}.',
                    field.pos
                );
                continue;
            }

            if (uniformIndex < 0) {
                Context.error(
                    'Uniform index for ${cls.name}.${field.name} '
                    + 'must be non-negative.',
                    field.pos
                );
                continue;
            }

            if (seenNames.exists(uniformName)) {
                Context.error(
                    'Duplicate uniform name "$uniformName" '
                    + 'in shader ${cls.name}.',
                    field.pos
                );
                continue;
            }

            if (seenIndices.exists(uniformIndex)) {
                Context.error(
                    'Duplicate uniform index $uniformIndex '
                    + 'in shader ${cls.name}.',
                    field.pos
                );
                continue;
            }

            seenNames.set(uniformName, true);
            seenIndices.set(uniformIndex, true);

            uniforms.push({
                name: uniformName,
                index: uniformIndex
            });
        }

        // Sort by the declared ProgramInfo array index.
        uniforms.sort(function(a, b) {
            return a.index - b.index;
        });

        // Require indices to be contiguous, starting at zero.
        for (i in 0...uniforms.length) {
            if (uniforms[i].index != i) {
                Context.error(
                    'Uniform indices in ${cls.name} must be contiguous '
                    + 'from 0. Expected $i, got ${uniforms[i].index}.',
                    cls.pos
                );
            }
        }

        return uniforms;
    }
}
#end

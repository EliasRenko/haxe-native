
#if macro
import haxe.macro.Context;
import haxe.macro.Expr;
import haxe.macro.Type;
import haxe.io.Path;
import sys.FileSystem;

typedef ShaderData = {
    var id:Int;
    var name:String;
    var path:Array<String>;
    var vertexSource:String;
    var fragmentSource:String;
}

class ShaderRegistryMacro {


    public static function build(packageName:String):Array<Field> {
        var fields = Context.getBuildFields();
        var pos = Context.currentPos();

        var packagePath = StringTools.replace(packageName, ".", "/");
        var modules:Array<String> = [];

        // 1. Scan every Haxe classpath.
        for (classPath in Context.getClassPath()) {
            var directory = Path.join([classPath, packagePath]);

            if (!FileSystem.exists(directory)
                || !FileSystem.isDirectory(directory)) {
                continue;
            }

            for (file in FileSystem.readDirectory(directory)) {
                if (Path.extension(file) != "hx") {
                    continue;
                }

                var moduleName = Path.withoutExtension(file);

                if (StringTools.startsWith(moduleName, "_")) {
                    continue;
                }

                modules.push(packageName + "." + moduleName);
            }
        }

        // 2. Deduplicate module paths and sort them.
        var uniqueModules:Array<String> = [];

        for (moduleName in modules) {
            if (uniqueModules.indexOf(moduleName) == -1) {
                uniqueModules.push(moduleName);
            }
        }

        uniqueModules.sort(Reflect.compare);

        if (uniqueModules.length == 0) {
            Context.error(
                'No Haxe modules found for package "$packageName".',
                pos
            );
        }

        // 3. Discover and validate shader classes.
        var shaders:Array<ShaderData> = [];
        var seen = new Map<String, Bool>();

        for (moduleName in uniqueModules) {
            var types:Array<Type>;

            try {
                types = Context.getModule(moduleName);
            } catch (e:Dynamic) {
                Context.error(
                    'Could not load shader module "$moduleName": $e',
                    pos
                );
                continue;
            }

            for (type in types) {
                switch (type) {
                    case TInst(classRef, _):
                        var cls = classRef.get();
                        var expectedName =
                            moduleName.split(".").pop();

                        // Only inspect the class matching the filename.
                        if (cls.name != expectedName) {
                            continue;
                        }

                        if (!extendsShader(cls)) {
                            continue;
                        }

                        var className =
                            cls.pack.concat([cls.name]).join(".");

                        if (seen.exists(className)) {
                            Context.error(
                                'Duplicate shader registration: $className',
                                cls.pos
                            );
                        }

                        seen.set(className, true);

                        validateShader(cls);

                        shaders.push({
                            id: getShaderId(cls),
                            name: className,
                            path: cls.pack.concat([cls.name]),
                            vertexSource: getMetadataString(
                                cls,
                                ":shaderSourceVert"
                            ),
                            fragmentSource: getMetadataString(
                                cls,
                                ":shaderSourceFrag"
                            )
                        });

                    default:
                }
            }
        }

        // 4. Sort using the IDs generated by ShaderMacro.
        shaders.sort(function(a, b) {
            return a.id - b.id;
        });

        // 5. IDs used as array indices must be unique and contiguous.
        for (i in 0...shaders.length) {
            if (shaders[i].id != i) {
                Context.error(
                    'Shader IDs must be contiguous from 0. Expected $i, '
                    + 'got ${shaders[i].id} for ${shaders[i].name}.',
                    pos
                );
            }
        }

        // 6. Generate the shader class array.
        var classExpressions:Array<Expr> = [];

        for (shader in shaders) {
            var path = shader.path;
            classExpressions.push(macro $p{path});
        }

        fields.push({
            name: "shaderClasses",
            access: [APublic, AStatic, AFinal],
            kind: FVar(
                macro:Array<Class<data.Shader>>,
                macro $a{classExpressions}
            ),
            pos: pos
        });

        // 7. Generate ShaderDefinition objects.
        var definitionExpressions:Array<Expr> = [];

        for (shader in shaders) {
            var name = shader.name;
            var id = shader.id;
            var vertexSource = shader.vertexSource;
            var fragmentSource = shader.fragmentSource;

            definitionExpressions.push(
                macro new ShaderDefinition(
                    $v{name},
                    $v{id},
                    $v{vertexSource},
                    $v{fragmentSource}
                )
            );
        }

        fields.push({
            name: "definitions",
            access: [APublic, AStatic, AFinal],
            kind: FVar(
                macro:Array<ShaderDefinition>,
                macro $a{definitionExpressions}
            ),
            pos: pos
        });

        Context.info(
            'Discovered ${shaders.length} shaders in "$packageName".',
            pos
        );

        return fields;
    }

    static function extendsShader(
        cls:haxe.macro.Type.ClassType
    ):Bool {
        var parent = cls.superClass;

        while (parent != null) {
            var parentClass = parent.t.get();

            if (parentClass.name == "Shader"
                && parentClass.pack.length == 1
                && parentClass.pack[0] == "data") {
                return true;
            }

            parent = parentClass.superClass;
        }

        return false;
    }

    static function validateShader(
        cls:haxe.macro.Type.ClassType
    ):Void {
        var hasVertex = false;
        var hasFragment = false;

        for (meta in cls.meta.get()) {
            switch (meta.name) {
                case ":shaderSourceVert":
                    hasVertex = true;

                case ":shaderSourceFrag":
                    hasFragment = true;

                default:
            }
        }

        if (!hasVertex) {
            Context.error(
                '${cls.name} is missing @:shaderSourceVert metadata.',
                cls.pos
            );
        }

        if (!hasFragment) {
            Context.error(
                '${cls.name} is missing @:shaderSourceFrag metadata.',
                cls.pos
            );
        }
    }

    static function getMetadataString(
        cls:haxe.macro.Type.ClassType,
        metadataName:String
    ):String {
        for (meta in cls.meta.get()) {
            if (meta.name != metadataName) {
                continue;
            }

            if (meta.params.length != 1) {
                Context.error(
                    '$metadataName on ${cls.name} must have one argument.',
                    cls.pos
                );
            }

            switch (meta.params[0].expr) {
                case EConst(CString(value, _)):
                    return value;

                default:
                    Context.error(
                        '$metadataName on ${cls.name} must contain a string literal.',
                        meta.params[0].pos
                    );
            }
        }

        Context.error(
            '${cls.name} is missing $metadataName metadata.',
            cls.pos
        );

        return "";
    }

    static function getShaderId(
        cls:haxe.macro.Type.ClassType
    ):Int {
        for (meta in cls.meta.get()) {
            if (meta.name != ":shaderId") {
                continue;
            }

            if (meta.params.length != 1) {
                Context.error(
                    'Invalid shaderId metadata on ${cls.name}.',
                    cls.pos
                );
            }

            switch (meta.params[0].expr) {
                case EConst(CInt(value)):
                    return Std.parseInt(value);

                default:
                    Context.error(
                        'shaderId on ${cls.name} must be an integer.',
                        meta.params[0].pos
                    );
            }
        }

        Context.error(
            'No generated :shaderId metadata found for ${cls.name}. '
            + 'Check that ShaderMacro adds the metadata.',
            cls.pos
        );

        return -1;
    }
}
#end

public function getProgramInfo(vertexSource:String, fragmentSource:String):ProgramInfo {

        var _programInfo:ProgramInfo = new ProgramInfo("programInfo");

        // ** Create and link the program.
        var _program:Program = gl.createProgram();
        createAndAttachShader(_program, vertexSource, "vert");
        createAndAttachShader(_program, fragmentSource, "frag");
        
        // ** Link the program.
        gl.linkProgram(_program);
        gl.validateProgram(_program);

        // ** Check if the program linked successfully
        if (gl.getProgramParameter(_program, Context.LINK_STATUS) == 0) {
            var _error:String = gl.getProgramInfoLog(_program);
            throw "Unable to link the shader program: " + _error;
        }

        // ** Get the attributes
        var numAttribs = gl.getProgramParameter(_program, Context.ACTIVE_ATTRIBUTES);
        var activeInfo:ActiveInfo;
        var dataPerVertex:Int = 0;

        for (i in 0...numAttribs) {
            activeInfo = gl.getActiveAttrib(_program, i);

            var location:Int = gl.getAttribLocation(_program, activeInfo.name);
            var format:Int = getAttributeFormat(activeInfo.type);
            _programInfo.addAttribute(activeInfo.name, format, location);

            dataPerVertex += AttributeFormat.getValuesPerVertex(format);
        }

        _programInfo.dataPerVertex = dataPerVertex;

        // ** Get the uniforms
        var numUni = gl.getProgramParameter(_program, Context.ACTIVE_UNIFORMS);

        for (i in 0...numUni) {
            activeInfo = gl.getActiveUniform(_program, i);
            
            var format:UniformFormat = getUniformFormat(activeInfo.type);
            var setter:Uniform = getUniformSetter(format, gl.getUniformLocation(_program, activeInfo.name));

            // ** If Uniform is a texture, add it to the texture list.
            if (activeInfo.type == SAMPLER_2D || activeInfo.type == SAMPLER_CUBE) {
                _programInfo.addTexture(activeInfo.name, format, setter);
            } else {
                _programInfo.addUniform(activeInfo.name, format, setter);
            }
        }

        if (gl.getProgramParameter(_program, Context.LINK_STATUS) == 0) {
            var _error:String = gl.getProgramInfoLog(_program);
            throw "Unable to link the shader program: " + _error;
        }

        // ** Assign locations to uniforms and textures
        for (i in 0..._programInfo.uniforms.length) _programInfo.uniforms[i].location = gl.getUniformLocation(_program, _programInfo.uniforms[i].name);
        for (i in 0..._programInfo.textures.length) _programInfo.textures[i].location = gl.getUniformLocation(_program, _programInfo.textures[i].name);

        _programInfo.programId = __programs.push(_program) - 1;

        return _programInfo;
    }

    private function createAndAttachShader(program:Program, source:String, type:String):Void {
        
        var _glType:Int = switch (type) {
            case "vert": Context.VERTEX_SHADER;
            case "frag": Context.FRAGMENT_SHADER;
            default: throw "Invalid shader type: " + type;
        };

        var shader = gl.createShader(_glType);

        gl.shaderSource(shader, source);
        gl.compileShader(shader);

        // ** Check if the shader compiled successfully.
        if (gl.getShaderParameter(shader, Context.COMPILE_STATUS) == 0) {
            var error = gl.getShaderInfoLog(shader);
            throw "Error compiling shader: " + error;
        }

        gl.attachShader(program, shader);
        gl.deleteShader(shader);
    }

    private function getAttributeFormat(value:Int):AttributeFormat {

        return switch (value) {
			
            case 35664: AttributeFormat.VEC2; // GL_FLOAT_VEC2
            case 35665: AttributeFormat.VEC3; // GL_FLOAT_VEC3
            case 35666: AttributeFormat.VEC4; // GL_FLOAT_VEC4
            case 5126: AttributeFormat.FLOAT; // GL_FLOAT
            case 5124: AttributeFormat.INT; // GL_INT
            case 5125: AttributeFormat.UNSIGNED_INT; // GL_UNSIGNED_INT
            case 5120: AttributeFormat.BYTE; // GL_BYTE
            case 5121: AttributeFormat.UNSIGNED_BYTE; // GL_UNSIGNED_BYTE
            case 5122: AttributeFormat.SHORT; // GL_SHORT
            case 5123: AttributeFormat.UNSIGNED_SHORT; // GL_UNSIGNED_SHORT
			
			default: null;
		}
    }

    private function getUniformFormat(value:Int):UniformFormat {

        return switch (value) {
			
            case 5126: UniformFormat.FLOAT; // GL_FLOAT
            case 35664: UniformFormat.VEC2; // GL_FLOAT_VEC2
            case 35665: UniformFormat.VEC3; // GL_FLOAT_VEC3
            case 35666: UniformFormat.VEC4; // GL_FLOAT_VEC4
			case 35676: UniformFormat.MAT4;
			case 35678: UniformFormat.SAMPLER_2D;
            case 35680: UniformFormat.SAMPLER_CUBE;
            //case 35666: UniformFormat.FLOAT_VEC4; // GL_FLOAT_VEC4

			default: null;
		}
    }